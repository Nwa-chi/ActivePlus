# Generate a random value with at least 32 characters.
SESSION_SECRET=

# Twilio Verify v2 credentials for Dutch SMS OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Mapbox token with Search and Directions access.
MAPBOX_ACCESS_TOKEN=

# Stripe server credentials. Enable card and iDEAL in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated administrator emails permitted to access /admin.
ADMIN_EMAILS=admin@attivplus.com

# Use "azure" for Microsoft Entra/App Service Authentication, or "cognito"
# during the rollback period. Azure mode fails closed outside App Service.
ADMIN_AUTH_PROVIDER=cognito

# Optional localhost-only administrator identity. Ignored in production.
DEV_ADMIN_EMAIL=

# Cloud runtime region. Set this explicitly in the selected hosting environment.
AWS_REGION=
ACTIVEPLUS_TABLE_NAME=ActivePlusProduction
APP_URL=https://attivplus.com

# Temporary rollback identity provider for administrators.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
